GRPC_ADDR=":50051"
GRPC_WEB_ALLOWED_ORIGINS="http://localhost:5173"

DB_DSN="postgresql://user:password@localhost:5432/flower?sslmode=disable"
DB_AUTO_MIGRATE="true"

# Supabase Storage via S3 protocol (Dashboard → Project Settings → Storage → S3 credentials).
# Enable "S3 protocol access" in Storage settings. Create a public bucket (e.g. flower) for tokenURI URLs.
# Docs: https://supabase.com/docs/guides/storage/s3/authentication
S3_ENDPOINT="https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3"
# Use the same region as your Supabase project (e.g. ap-northeast-1).
S3_REGION="ap-northeast-1"
S3_ACCESS_KEY="your-s3-access-key-id"
S3_SECRET_KEY="your-s3-secret-access-key"
S3_BUCKET="flower"
# Must match public object URL base: .../storage/v1/object/public/<bucket>
S3_PUBLIC_BASE_URL="https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/flower"
# Must be true for Supabase: virtual-hosted style puts the bucket in the hostname
# (flower.PROJECT.storage.supabase.co), which is invalid TLS. Path-style keeps host PROJECT.storage.supabase.co.
S3_FORCE_PATH_STYLE="true"

CHAIN_ID="1337"
NFT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
